# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mantém o exemplo de variáveis versionado (as linhas .env*/.vercel repetidas abaixo anulavam a exceção)
!.env.example

# estado de ferramentas de design e cache de tipos
.impeccable/
tsconfig.tsbuildinfo

# exports com dados reais de pacientes (LGPD) — nunca versionar
/data/

# estado local do CLI do Supabase
supabase/.temp/
