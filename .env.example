# Supabase: URL e chave pública; nenhuma service role no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor: assinatura pública de contratos, cron de confirmações e scripts de provisionamento.
SUPABASE_SERVICE_ROLE_KEY=
# Senha do banco (só para `supabase db push` / scripts; nunca no front).
SUPABASE_DB_PASSWORD=
# E-mail do Dr. (opcional: restringe o painel a esta conta além da participação no consultório) e URL canônica.
AUTH_EMAIL_PERMITIDO=
APP_URL=
# Outras origens aceitas nos POSTs de /api, separadas por vírgula (ex.: o domínio antigo do consultório).
APP_ORIGENS_EXTRAS=
# Senha inicial usada por `node supabase/scripts/criar-usuario.mjs` (apague depois de trocar no painel).
DR_SENHA_INICIAL=
# Segredo do cron da Vercel (/api/cron/confirmacoes). A Vercel envia Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Saída única de mensagens: webhook privado do n8n (confirmações automáticas e envio pelo painel).
N8N_ENVIO_WEBHOOK_URL=
N8N_ENVIO_WEBHOOK_SECRET=
# Habilitar após o n8n adotar docs/BACKEND-FASE2.md: correlacao-v1.
N8N_ENVIO_PROTOCOLO=
# WhatsApp do consultório via UAZ-API (só servidor). Base ex.: https://api.uazapi.com. O admintoken só cria instâncias;
# o token de cada instância fica em whatsapp_conexoes.instance_token e nunca vai ao navegador.
UAZ_BASE_URL=
UAZ_ADMIN_TOKEN=
# Opcional (fase 2): segredo para validar o webhook de conexão/mensagens da UAZ.
UAZ_WEBHOOK_SECRET=
# Fonte de consumo: configurar depois de aprovar provedor e protocolo.
IA_CONSUMO_API_URL=
IA_CONSUMO_API_KEY=
# Fonte de câmbio: chave pode não ser necessária, conforme fonte aprovada.
CAMBIO_API_URL=
CAMBIO_API_KEY=
# Assinatura com validade jurídica reforçada (ainda não implementado; ver lib/servidor/assinatura.ts).
ZAPSIGN_API_TOKEN=
CLICKSIGN_ACCESS_TOKEN=
